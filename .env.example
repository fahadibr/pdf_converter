# Public origin used for metadata, canonical URLs, and sitemap entries.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Conversion service settings. Keep the upload limit at or below 25 MB unless
# the Nginx request cap and temporary storage are adjusted too.
NEXT_PUBLIC_MAX_UPLOAD_MB=25
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
CONVERSION_TIMEOUT_MS=45000
LIBREOFFICE_BIN=soffice

# Optional address displayed on the contact page.
SUPPORT_EMAIL=
